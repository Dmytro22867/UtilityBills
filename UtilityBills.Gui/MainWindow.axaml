<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="UtilityBills.Gui.MainWindow"
        Title="Облік комунальних платежів — UtilityBills"
        Width="760" Height="520"
        WindowStartupLocation="CenterScreen">
    <Grid RowDefinitions="Auto,*,Auto" Margin="18" RowSpacing="14">
        <Border Grid.Row="0" Background="#1E293B" CornerRadius="8" Padding="14">
            <StackPanel Spacing="4">
                <TextBlock Text="Облік комунальних платежів (UtilityBills)"
                           FontSize="20" FontWeight="Bold" Foreground="#38BDF8"/>
                <TextBlock x:Name="StatusText"
                           Text="Завантаження даних..."
                           FontSize="13" Foreground="#CBD5E1"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="1.15*,1*" ColumnSpacing="16">
            <Border Grid.Column="0" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="12">
                <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8">
                    <TextBlock Grid.Row="0" Text="Послуги та лічильники" FontWeight="Bold" FontSize="15"/>
                    <ComboBox Grid.Row="1" x:Name="OrderComboBox" HorizontalAlignment="Stretch"
                              SelectionChanged="OrderComboBox_SelectionChanged">
                        <ComboBoxItem Content="За порядком у списку" IsSelected="True"/>
                        <ComboBoxItem Content="Спочатку найдорожчі за тарифом"/>
                    </ComboBox>
                    <ListBox Grid.Row="2" x:Name="MetersListBox"
                             SelectionChanged="MetersListBox_SelectionChanged"/>
                </Grid>
            </Border>

            <Border Grid.Column="1" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="14">
                <StackPanel Spacing="10">
                    <TextBlock Text="Нарахування платежу" FontWeight="Bold" FontSize="15"/>
                    <TextBlock x:Name="SelectedTitleText" Text="Оберіть послугу зі списку ліворуч"
                               FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock x:Name="TariffDetailsText" Text="" Foreground="#475569" TextWrapping="Wrap"/>
                    <TextBlock x:Name="PromptText" Text="Показання:" Margin="0,6,0,0"/>
                    <TextBox x:Name="ReadingTextBox" Watermark="Введіть значення..."/>
                    <Button Content="Розрахувати та додати до квитанції"
                            Click="CalculateButton_Click"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Padding="10,8"/>
                    <TextBlock x:Name="BillResultText" Text="" FontSize="15" FontWeight="Bold" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="12">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <TextBlock x:Name="SummaryText"
                           VerticalAlignment="Center"
                           FontSize="14" FontWeight="SemiBold"
                           Text="Підсумок квитанції: опрацьовано 0, до сплати: 0,00 грн"/>
                <Button Grid.Column="1" Content="Скинути підсумок" Click="ResetButton_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>